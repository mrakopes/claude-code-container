#!/bin/bash
set -euo pipefail

profile="${CCD_PROFILE:-claude-agent}"
cfg="$HOME/.local/share/$profile"
mkdir -p "$cfg"

# per-profile git config, mounted read-only (see examples/gitconfig)
gitcfg_dir="$HOME/.config/ccd"
gitcfg=()
[ -f "$gitcfg_dir/$profile.gitconfig" ] && gitcfg=(
    -v "$gitcfg_dir":/home/agent/.config/ccd:ro
    -e GIT_CONFIG_GLOBAL="/home/agent/.config/ccd/$profile.gitconfig"
)

tty=(-i); [ -t 0 ] && [ -t 1 ] && tty=(-it)
name="$profile-$(basename "$PWD" | tr -c 'a-zA-Z0-9_.\n-' '_')-$$"

exec podman run --rm "${tty[@]}" \
    --userns=keep-id --cap-drop=ALL --security-opt no-new-privileges \
    --cgroup-parent=agents.slice \
    --memory="${CCD_MEM:-8g}" --memory-swap="${CCD_MEM:-8g}" \
    --cpus="${CCD_CPUS:-4}" --cpu-shares=512 \
    --pids-limit=2048 \
    --tmpfs /tmp:rw,size=2g,mode=1777 \
    --ulimit nofile=8192:8192 \
    -v "$PWD":"$PWD" -w "$PWD" \
    -v "$cfg":/home/agent/.claude \
    -e CLAUDE_CONFIG_DIR=/home/agent/.claude \
    "${gitcfg[@]}" \
    --name "$name" \
    localhost/claude-agent:latest claude "$@"

# @TODO - restricted network/egress
#    --network agent-net -e HTTPS_PROXY=http://egress-proxy:3128 \
