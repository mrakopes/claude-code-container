#!/bin/bash
set -euo pipefail

profile="${CCD_PROFILE:-claude-agent}"
# used in host paths (and the tmp cleanup), no "/" or ".." allowed
[[ "$profile" =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]] || { echo "ccd: invalid CCD_PROFILE=$profile" >&2; exit 1; }
cfg="$HOME/.local/share/$profile"
mkdir -p "$cfg"

# claude's temp dir (scratchpads, task output) on the host, survives restarts
tmpdir="${XDG_CACHE_HOME:-$HOME/.cache}/ccd/$profile/tmp"
mkdir -p "$tmpdir"
days="${CCD_TMP_DAYS:-14}"
[[ "$days" =~ ^[0-9]+$ ]] || { echo "ccd: invalid CCD_TMP_DAYS=$days" >&2; exit 1; }
# same path on the host as in the container: /tmp/ccd-<user>-<profile> -> $tmpdir
tmplink="/tmp/ccd-$(id -un)-$profile"
if [ -L "$tmplink" ] && [ "$(readlink "$tmplink")" = "$tmpdir" ]; then :
elif [ -e "$tmplink" ] || [ -L "$tmplink" ]; then
    echo "ccd: $tmplink exists and doesn't link to $tmpdir, not touching it" >&2
else
    ln -s "$tmpdir" "$tmplink"
fi

# per-profile git config, mounted read-only (see examples/gitconfig)
gitcfg_dir="$HOME/.config/ccd"
gitcfg=()
[ -f "$gitcfg_dir/$profile.gitconfig" ] && gitcfg=(
    -v "$gitcfg_dir":/home/agent/.config/ccd:ro
    -e GIT_CONFIG_GLOBAL="/home/agent/.config/ccd/$profile.gitconfig"
)

# main checkout of the git repo $PWD is in (also from a subdir or a linked worktree)
gitdir=$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)
repo=""
[ "$(basename "$gitdir")" = .git ] && repo=$(dirname "$gitdir")

# per-repo (or per-dir) subdir of $tmpdir, so containers of other projects don't share it
tmpkey_dir="${repo:-$PWD}"
tmpkey="$(basename "$tmpkey_dir" | tr -c 'a-zA-Z0-9_.\n-' '_')"
tmpkey="${tmpkey:0:32}-$(printf %s "$tmpkey_dir" | sha256sum | cut -c1-8)"
mkdir -p "$tmpdir/$tmpkey"
# last start of a container for <key>: <key>.stamp next to its dir, outside the mount
touch "$tmpdir/$tmpkey.stamp"
if [ "$days" -gt 0 ]; then
    for d in "$tmpdir"/*; do
        s="$d.stamp"
        case "$d" in *.stamp) [ -e "${d%.stamp}" ] || rm -f "$d"; continue ;; esac
        [ -d "$d" ] && [ ! -L "$d" ] || continue
        # no stamp yet (dir from before stamps): start counting now
        [ -e "$s" ] || { touch "$s"; continue; }
        # whole tree at once, nothing inside is walked for mtimes; rm doesn't follow symlinks
        if [ -n "$(find "$s" -maxdepth 0 -mtime +"$days")" ]; then
            rm -rf --one-file-system "$d" && rm -f "$s" || echo "ccd: couldn't fully remove $d" >&2
        fi
    done
fi

worktree=0
for a in "$@"; do
    case "$a" in -w|--worktree|--worktree=*) worktree=1 ;; esac
done

mounts=(-v "$PWD":"$PWD")
claude_args=()
if [ -n "$repo" ]; then
    # .git/config and hooks run code on the host -> read-only
    mkdir -p "$gitdir/hooks"
    gitro=(
        -v "$gitdir/config":"$gitdir/config":ro
        -v "$gitdir/hooks":"$gitdir/hooks":ro
    )
    if [ "$worktree" = 1 ]; then
        # claude --worktree: checkout read-only, agent works in .claude/worktrees/<name>
        case "$PWD/" in "$repo"/*) ;; *) echo "ccd: -w needs to be run inside $repo" >&2; exit 1 ;; esac
        wt="$repo/.claude/worktrees"
        mkdir -p "$wt"
        mounts=(
            -v "$repo":"$repo":ro
            -v "$gitdir":"$gitdir"
            "${gitro[@]}"
            -v "$wt":"$wt"
        )
        claude_args=(
            --add-dir "$repo"
            --settings '{"worktree":{"baseRef":"head"}}'
            --append-system-prompt "You work in a git worktree under $wt; make all edits and commits there. $repo is the user's checkout, mounted read-only: use it only to read or copy files that are not in git (e.g. .env, data). Paths the user gives under $repo mean the same file in your worktree."
        )
    elif [ "$repo" = "$PWD" ]; then
        mounts+=("${gitro[@]}")
    fi
fi

# egress: internal network without a route out, only the proxy reaches the internet
net=()
case "${CCD_NET:-}" in
    open) ;;
    "")
        CCD_PROFILE="$profile" "$(dirname "$(readlink -f "$0")")/ccd-proxy" start
        net=(--network "ccd-net-$profile")
        for v in HTTP_PROXY HTTPS_PROXY http_proxy https_proxy; do
            net+=(-e "$v=http://ccd-proxy-$profile:3128")
        done
        net+=(-e NO_PROXY=localhost,127.0.0.1,::1 -e no_proxy=localhost,127.0.0.1,::1)
        ;;
    *) echo "ccd: unknown CCD_NET=$CCD_NET (only 'open' or unset)" >&2; exit 1 ;;
esac

tty=(-i); [ -t 0 ] && [ -t 1 ] && tty=(-it)
name="$profile-$(basename "$PWD" | tr -c 'a-zA-Z0-9_.\n-' '_')"
name="${name:0:55}-$$" # also the hostname: max 63 chars

exec podman run --rm "${tty[@]}" \
    --userns=keep-id --cap-drop=ALL --security-opt no-new-privileges \
    --cgroup-parent=agents.slice \
    --memory="${CCD_MEM:-8g}" --memory-swap="${CCD_MEM:-8g}" \
    --cpus="${CCD_CPUS:-4}" --cpu-shares=512 \
    --pids-limit=2048 \
    --tmpfs /tmp:rw,size=2g,mode=1777 \
    -v "$tmpdir/$tmpkey":"$tmplink/$tmpkey" -e CLAUDE_CODE_TMPDIR="$tmplink/$tmpkey" \
    --mount type=tmpfs,destination=/run/user/"$(id -u)",tmpfs-mode=0700,tmpfs-size=16m,chown \
    -e XDG_RUNTIME_DIR=/run/user/"$(id -u)" \
    --ulimit nofile=8192:8192 \
    "${mounts[@]}" -w "$PWD" \
    -v "$cfg":/home/agent/.claude \
    -e CLAUDE_CONFIG_DIR=/home/agent/.claude \
    -e CCD_PROFILE="$profile" \
    "${gitcfg[@]}" \
    "${net[@]}" \
    --name "$name" --hostname "$name" \
    localhost/claude-agent:latest claude "${claude_args[@]}" "$@"
